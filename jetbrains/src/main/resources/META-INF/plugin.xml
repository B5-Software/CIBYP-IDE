<idea-plugin>
  <id>org.b5software.cibyp</id>
  <name>Could I Be Your Partner</name>
  <vendor url="https://github.com/B5-Software">B5-Software</vendor>
  <description><![CDATA[Native CIBYP tool window. Connect to a shared local or remote Agent instance; chat, select history, attach editor context, review proposed code, answer questions and approve tools. Requires CIBYP running separately.]]></description>
  <depends>com.intellij.modules.platform</depends>
  <resource-bundle>messages.CibypBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="CIBYP" anchor="right" factoryClass="org.b5software.cibyp.CibypToolWindow" icon="/icons/cibyp.svg"/>
  </extensions>
  <actions>
    <action id="CIBYP.AttachSelection" class="org.b5software.cibyp.AttachSelectionAction" text="Attach to CIBYP" description="Attach editor selection to the CIBYP conversation">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt A"/>
    </action>
    <action id="CIBYP.Explain" class="org.b5software.cibyp.ExplainAction" text="Explain with CIBYP">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
